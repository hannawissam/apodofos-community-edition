<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Apodofos.Core\Apodofos.Core.csproj" />
    <ProjectReference Include="..\..\src\Apodofos.Host\Apodofos.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\EXAMPLES\*.html" Link="Examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- the Windows shell's runtime switches (plain strings): compiled in, because the shell itself builds on Windows only -->
    <Compile Include="..\..\src\Apodofos.Desktop\WebView2Network.cs" Link="Shared\WebView2Network.cs" />
  </ItemGroup>
</Project>
