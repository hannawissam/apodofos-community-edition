<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Apodofos Report Analyzer" Manufacturer="Wissam HANNA" Version="$(var.AppVersion)"
           UpgradeCode="F4D8DA80-FBED-4F75-A47F-A25C42A06683" Scope="perUserOrMachine" Language="1033">
    <SummaryInformation Description="Apodofos Report Analyzer - offline Oracle AWR/ASH/Statspack analyzer" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Upgrade in place; same-version rebuilds also replace the installed copy. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Apodofos is already installed." AllowSameVersionUpgrades="yes" />

    <Icon Id="Apodofos.ico" SourceFile="..\assets\apodofos.ico" />
    <Property Id="ARPPRODUCTICON" Value="Apodofos.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/hannawissam/apodofos-community-edition" />

    <!-- Per-user by default (no admin); the "Install for" page of the wizard offers per-machine. -->
    <Property Id="ApplicationFolderName" Value="Apodofos" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />
    <WixVariable Id="WixUILicenseRtf" Value="$(StageDir)LICENSE.rtf" />

    <!-- Microsoft Edge WebView2 Evergreen runtime check (never downloaded or bundled by this installer). -->
    <Property Id="WEBVIEW2_VERSION">
      <RegistrySearch Id="Wv2Machine" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="WEBVIEW2_VERSION_USER">
      <RegistrySearch Id="Wv2User" Root="HKCU" Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR SKIPWEBVIEW2CHECK OR (WEBVIEW2_VERSION AND WEBVIEW2_VERSION &lt;&gt; &quot;0.0.0.0&quot;) OR (WEBVIEW2_VERSION_USER AND WEBVIEW2_VERSION_USER &lt;&gt; &quot;0.0.0.0&quot;)"
            Message="Apodofos needs the Microsoft Edge WebView2 Evergreen Runtime, which was not found. Install it from https://developer.microsoft.com/microsoft-edge/webview2/ (Evergreen Standalone Installer), then run this setup again." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="Apodofos">
        <Directory Id="CLIFOLDER" Name="cli" />
      </Directory>
    </StandardDirectory>
    <!-- WixUI_Advanced moves APPLICATIONFOLDER to %LOCALAPPDATA%\Programs\Apodofos for a per-user install. -->

    <Feature Id="Main" Title="Apodofos Report Analyzer" Description="The desktop application and the apodofos command line tool." AllowAbsent="no" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Description="Add an Apodofos shortcut to the desktop." Level="1000">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <Feature Id="PathFeature" Title="Add apodofos (CLI) to PATH" Description="Lets you run 'apodofos' from any new terminal window." Level="1000">
      <ComponentRef Id="PathUser" />
      <ComponentRef Id="PathMachine" />
    </Feature>
    <!-- Features default to unselected (Level 1000 > INSTALLLEVEL 1); select them in the wizard or via ADDLOCAL. -->

    <!-- Silent installs (no wizard): public property INSTALLFOLDER chooses the folder; a silent per-user install
         defaults to %LOCALAPPDATA%\Programs\Apodofos. The wizard sets APPLICATIONFOLDER itself. -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <SetProperty Id="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\Apodofos" Before="CostInitialize" Condition="UILevel &lt;= 3 AND MSIINSTALLPERUSER AND NOT INSTALLFOLDER" />
    <SetProperty Id="APPLICATIONFOLDER" Value="[INSTALLFOLDER]" After="CostInitialize" Condition="UILevel &lt;= 3 AND INSTALLFOLDER" />

    <ui:WixUI Id="WixUI_Advanced" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="APPLICATIONFOLDER">
      <Component Id="ApodofosExe" Guid="*"><File Id="ApodofosExe" Source="$(StageDir)Apodofos.exe" KeyPath="yes" /></Component>
      <Component Id="ApodofosCli" Guid="*" Directory="CLIFOLDER"><File Id="ApodofosCli" Source="$(StageDir)cli\apodofos.exe" KeyPath="yes" /></Component>
      <Component Id="LegalLicense" Guid="*"><File Source="$(StageDir)LICENSE" KeyPath="yes" /></Component>
      <Component Id="LegalNotice" Guid="*"><File Source="$(StageDir)NOTICE" KeyPath="yes" /></Component>
      <Component Id="LegalThirdParty" Guid="*"><File Source="$(StageDir)THIRD-PARTY-NOTICES.md" KeyPath="yes" /></Component>
      <Component Id="LegalRuntime" Guid="*"><File Source="$(StageDir)DOTNET-RUNTIME-THIRD-PARTY-NOTICES.txt" KeyPath="yes" /></Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuLnk" Name="Apodofos Report Analyzer" Target="[APPLICATIONFOLDER]Apodofos.exe" WorkingDirectory="APPLICATIONFOLDER" Icon="Apodofos.ico" />
        <RegistryValue Root="HKCU" Key="Software\Apodofos\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopLnk" Name="Apodofos Report Analyzer" Target="[APPLICATIONFOLDER]Apodofos.exe" WorkingDirectory="APPLICATIONFOLDER" Icon="Apodofos.ico" />
        <RegistryValue Root="HKCU" Key="Software\Apodofos\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <DirectoryRef Id="CLIFOLDER">
      <Component Id="PathUser" Guid="*" Condition="NOT ALLUSERS=1">
        <Environment Id="PathUserEnv" Name="PATH" Value="[CLIFOLDER]" Action="set" Part="last" System="no" Permanent="no" />
        <RegistryValue Root="HKCU" Key="Software\Apodofos\Installer" Name="PathUser" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="PathMachine" Guid="*" Condition="ALLUSERS=1">
        <Environment Id="PathMachineEnv" Name="PATH" Value="[CLIFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\Apodofos\Installer" Name="PathMachine" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>





