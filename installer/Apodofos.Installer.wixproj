<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Builds <ApodofosReleasePrefix>-Setup-<version>-<rid>.msi (identity from Edition.props via Directory.Build.props). Run via release.ps1
       (it stages the published files and generates the licence RTF first). Not part of Apodofos.slnx on purpose.
       Overridable from release.ps1: -p:StageDir, -p:ArtifactsDir, -p:Rid. -->
  <PropertyGroup>
    <Rid Condition="'$(Rid)' == ''">win-x64</Rid>
    <OutputName>$(ApodofosReleasePrefix)-Setup-$(Version)-$(Rid)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Platform>x64</Platform>
    <!-- ICE61: same-version upgrades are allowed on purpose; ICE105: the optional machine-wide PATH component is only installed in per-machine mode; ICE38/43/57: the shortcut components come in a per-user (HKCU key path) and an all-users (HKLM key path) variant selected by ALLUSERS, which the static check cannot see. -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE61;ICE91;ICE105</SuppressIces>
    <ArtifactsDir Condition="'$(ArtifactsDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\</ArtifactsDir>
    <!-- Staging folder filled by release.ps1 -->
    <StageDir Condition="'$(StageDir)' == ''">$(ArtifactsDir)stage\</StageDir>
    <DefineConstants>$(DefineConstants);StageDir=$(StageDir);AppVersion=$(Version);ProductName=$(ApodofosProductName);ProductSlug=$(ApodofosProductSlug);DesktopExe=$(ApodofosDesktopExe);CliExe=$(ApodofosCliExe);UpgradeCode=$(ApodofosUpgradeCode)</DefineConstants>
    <!-- the former command names keep working (cli\apodofos.cmd from 1.0.x, cli\apodofos-report.cmd from 1.1.0) and the 1.1.0 data folder
         is cleaned on uninstall, only for the edition that claims the earlier data. Keep these names in step with release.ps1. -->
    <DefineConstants Condition="'$(ApodofosMigrateLegacyData)' == 'true'">$(DefineConstants);CliAlias1=apodofos;CliAlias2=apodofos-report;LegacyDataSlug=ReportAnalyzer;LegacyData=1</DefineConstants>
    <OutputPath>$(ArtifactsDir)installer-build\</OutputPath>
    <IntermediateOutputPath>$(ArtifactsDir)installer-obj\</IntermediateOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
