root = true

[*.cs]
# Culture-sensitive string operations must be explicit: identical behaviour on every OS and in invariant-globalization mode.
# CA1307 is deliberately not enabled: it only flags Contains/Replace overloads that are already ordinal (hundreds of false alarms).
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA1311.severity = warning
