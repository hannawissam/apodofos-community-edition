<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.7</Version>
    <Company>Wissam HANNA</Company>
    <Authors>Wissam HANNA</Authors>
    <Product>Apodofos Report Analyzer</Product>
    <Copyright>Copyright (c) 2026 Wissam HANNA</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- one behaviour on every OS: no ICU/NLS dependency (month names etc. are handled by explicit tables) -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
